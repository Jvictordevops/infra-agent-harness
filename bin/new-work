#!/usr/bin/env bash
# Create a new work folder: work/<context>/<YYYY-MM-DD.slug>/ with README, ROADMAP, RECORD/, evidence/.
# Usage: bin/new-work <context> <type> <slug> [--date YYYY-MM-DD] [--title "Human title"]
#   context  global, or a folder with contexts/<context>/ in the repository
#   type     prj (project) | inc (incident) | inv (investigation) | poc (proof of concept)
#   slug     kebab-case, up to 5 words
# Repository: $IAH_REPO, else the git repository of the current directory.
# Templates come from the harness, in the repository language (bin/render-template).
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")" && pwd)"
ROOT="${IAH_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
ROOT="$(cd "$ROOT" && pwd)"

contexts_list() {
  local d n out="global"
  for d in "$ROOT"/contexts/*/; do
    [ -d "$d" ] || continue
    n="$(basename "$d")"
    case "$n" in _*) continue ;; esac
    out="$out|$n"
  done
  printf '%s' "$out"
}
usage() {
  echo "usage: $(basename "$0") <context> <type> <slug> [--date YYYY-MM-DD] [--title \"Human title\"]" >&2
  echo "  context: $(contexts_list)   type: prj|inc|inv|poc   slug: kebab-case" >&2
  exit 2
}
die() { echo "new-work: $*" >&2; exit 1; }

[ $# -ge 3 ] || usage
CONTEXT="$1"; TYPE="$2"; SLUG="$3"; shift 3
DATE="$(date +%Y-%m-%d)"; TITLE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --date) [ $# -ge 2 ] || usage; DATE="$2"; shift 2 ;;
    --title) [ $# -ge 2 ] || usage; TITLE="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

case "|$(contexts_list)|" in *"|$CONTEXT|"*) ;; *) die "unknown context '$CONTEXT' ($(contexts_list)); create contexts/$CONTEXT/ first" ;; esac
case "$TYPE" in prj|inc|inv|poc) ;; *) die "invalid type '$TYPE' (prj|inc|inv|poc)";; esac
echo "$SLUG" | grep -Eq '^[a-z0-9]+(-[a-z0-9]+)*$' || die "slug must be kebab-case [a-z0-9-]: '$SLUG'"
echo "$SLUG" | grep -Eq -- '-(v[0-9]+|final|definitivo)$|^(estado|resumen|backup)-' && die "forbidden slug pattern: '$SLUG'"
[ "$(echo "$SLUG" | tr '-' '\n' | wc -l | tr -d ' ')" -le 5 ] || die "slug must have <=5 words: '$SLUG'"
echo "$DATE" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || die "date must be YYYY-MM-DD: '$DATE'"
if date -j -f %Y-%m-%d "$DATE" +%Y-%m-%d >/dev/null 2>&1 || date -d "$DATE" +%Y-%m-%d >/dev/null 2>&1; then :; else
  die "invalid date: '$DATE'"
fi
case "$TITLE" in *$'\t'*|*$'\n'*) die "title cannot contain tabs or newlines" ;; esac

ID="$DATE.$SLUG"
DIR="$ROOT/work/$CONTEXT/$ID"
[ -e "$DIR" ] && die "already exists: work/$CONTEXT/$ID"
existing="$(ls -d "$ROOT"/work/*/*."$SLUG" 2>/dev/null || true)"
[ -n "$existing" ] && echo "new-work: warning: slug already used by: ${existing#"$ROOT"/}" >&2

[ -n "$TITLE" ] || TITLE="$(echo "$SLUG" | tr '-' ' ')"

render() { # $1 = template name
  "$HERE/render-template" --repo "$ROOT" "$1" ID="$ID" TYPE="$TYPE" COMPANY="$CONTEXT" \
    DATE="$DATE" TITLE="$TITLE" PREV="(initial revision)"
}

mkdir -p "$DIR/RECORD" "$DIR/ROADMAP" "$DIR/evidence" "$DIR/.tmp"
touch "$DIR/RECORD/.gitkeep" "$DIR/evidence/.gitkeep"
render README | awk -v t="$TYPE" '
  /^<!-- type:[a-z]+ -->$/ { split($0, a, /[: ]/); cur = a[3]; next }
  /^<!-- \/type:[a-z]+ -->$/ { cur = ""; next }
  cur == "" || cur == t { print }
' > "$DIR/README.md"
render roadmap > "$DIR/ROADMAP/$DATE.md"

echo "created work/$CONTEXT/$ID"
echo "  README.md  ROADMAP/$DATE.md  RECORD/  evidence/  .tmp/"
echo "next: fill Goal/Constraints in README.md"
