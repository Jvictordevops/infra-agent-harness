#!/usr/bin/env bash
# Check the setup of this machine for the harness. Read-only: it never changes your home or your repos
# (link-harness runs with --dry-run; the only write is git fetch in the harness checkout, skipped with
# IAH_NO_FETCH=1). Prints one summary to paste back. Never prints keys or tokens.
# Usage: bin/doctor [--tests]
#   --tests   also run the tests of the guards and the packs on this machine (a few minutes on WSL)
# Optional modules active for the repository (.harness.conf "modules=a,b", IAH_MODULES overrides) add
# their checks from modules/<name>/doctor.sh.
# Repository with your works: $IAH_REPO, else the git repository of the current directory (optional).
# 'cond && ok … || warn …' is safe: ok/warn/fail only append to an array and never fail.
# shellcheck disable=SC2015,SC2088
set -uo pipefail

RUN_TESTS=0
for a in "$@"; do
  case "$a" in
    --tests) RUN_TESTS=1 ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: doctor [--tests]" >&2; exit 2 ;;
  esac
done

HARNESS="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd)"
# shellcheck source-path=SCRIPTDIR source=lib/vocab.sh
. "$HARNESS/bin/lib/vocab.sh"
# shellcheck source-path=SCRIPTDIR source=lib/packs.sh
. "$HARNESS/bin/lib/packs.sh"
# shellcheck source-path=SCRIPTDIR source=lib/profile.sh
. "$HARNESS/bin/lib/profile.sh"
REPO="${IAH_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"

if [ "$(uname)" = "Darwin" ]; then MACHINE=macos; elif grep -qi microsoft /proc/version 2>/dev/null; then MACHINE=wsl; else MACHINE=linux; fi
R=(); ok() { R+=("OK    $*"); }; warn() { R+=("WARN  $*"); }; fail() { R+=("FAIL  $*"); }

# 1. Harness checkout
if git -C "$HARNESS" rev-parse --git-dir >/dev/null 2>&1; then
  [ "${IAH_NO_FETCH:-0}" = 1 ] || git -C "$HARNESS" fetch -q 2>/dev/null || warn "harness: git fetch failed (network / credentials?)"
  behind="$(git -C "$HARNESS" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo '?')"
  [ "$behind" = 0 ] && ok "harness up to date ($HARNESS)" || warn "harness behind its upstream by $behind: git -C $HARNESS pull --rebase"
else
  ok "harness at $HARNESS (not a git checkout)"
fi

# 1b. Plugin mode and stable link
sl="$(stable_link)"
if plugin_mode; then
  ok "plugin mode: on (installed_plugins.json / IAH_PLUGIN)"
  if [ -L "$sl" ] && [ -d "$sl/bin/hooks" ]; then ok "stable link $sl -> $(readlink "$sl")"
  elif [ -L "$sl" ]; then warn "stable link $sl points to $(readlink "$sl"), which has no bin/hooks (start a Claude Code session to refresh it)"
  else warn "stable link $sl missing (the SessionStart hook creates it when Claude Code starts a session)"; fi
else
  ok "plugin mode: off (manual install)"
fi

# 1c. Security profile (bin/security-profile): always shown
pf="$(profile_file)"; praw="$(profile_raw profile)"
pchosen="$(profile_packs "$HARNESS" | paste -sd, -)"
ok "security profile: $(profile_name) · packs: ${pchosen:-none} ($pf$([ -f "$pf" ] || echo ', missing: defaults'))"
case "$praw" in
  ''|permissive|standard|strict) ;;
  isolated) warn "security profile 'isolated' comes with the container (v0.2); using standard: security-profile set <profile>" ;;
  *) warn "security profile '$praw' is not valid; using standard: security-profile set permissive|standard|strict" ;;
esac
punknown="$(profile_unknown_packs "$HARNESS" | paste -sd, -)"
[ -z "$punknown" ] || warn "packs= names packs that are not installed, ignored: $punknown"

# 2. Repository with your works (optional)
if [ -n "$REPO" ] && [ "$REPO" != "$HARNESS" ]; then
  hp="$(git -C "$REPO" config core.hooksPath || true)"; sl="$(stable_link)"
  if [ "$hp" = "$HARNESS/bin/hooks" ]; then ok "repo $REPO: hooksPath -> harness bin/hooks"
  elif [ "$hp" = "$sl/bin/hooks" ]; then ok "repo $REPO: hooksPath -> stable link bin/hooks ($sl)"
  elif [ -z "$hp" ]; then warn "repo $REPO: core.hooksPath is not set (git hooks inactive): cd $REPO && $HARNESS/bin/link-harness$(plugin_mode || echo "   (manual install: git -C $REPO config core.hooksPath $HARNESS/bin/hooks)")"
  else warn "repo $REPO: hooksPath is '$hp', not $HARNESS/bin/hooks (left as is)"; fi
  vocab_load "$REPO" 2>/dev/null; ok "repo $REPO: record language '$VOC_LANG' (.harness.conf)"
  ok "repo $REPO: check-work method '$(conf_method "$REPO" 2>/dev/null)' (.harness.conf / IAH_METHOD)"
  # work repo behind its upstream (local refs only: no fetch of the work repo)
  if up="$(git -C "$REPO" rev-parse --abbrev-ref '@{u}' 2>/dev/null)"; then
    wb="$(git -C "$REPO" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
    [ "$wb" = 0 ] && ok "repo $REPO: not behind $up (last fetched state)" || warn "repo $REPO: work repo is $wb commit(s) behind $up: git -C $REPO pull --rebase"
  fi
  # GLOBAL.md of the work repo must be what ~/.claude/CLAUDE.md resolves to
  if [ -f "$REPO/GLOBAL.md" ]; then
    [ "$(readlink -f "$HOME/.claude/CLAUDE.md" 2>/dev/null)" = "$(readlink -f "$REPO/GLOBAL.md")" ] \
      && ok "~/.claude/CLAUDE.md -> $REPO/GLOBAL.md" \
      || warn "~/.claude/CLAUDE.md does not resolve to $REPO/GLOBAL.md: bin/link-harness (from $REPO)"
  fi
  # private denylist (denylist= in .harness.conf)
  dl="$(conf_denylist "$REPO")"; dl_link="$HOME/.config/infra-agent-harness/denylist.txt"
  if [ -n "$dl" ]; then
    if [ -f "$dl" ] && [ "$(readlink -f "$dl_link" 2>/dev/null)" = "$(readlink -f "$dl")" ]; then ok "denylist: $dl_link -> $dl"
    elif [ ! -f "$dl" ]; then warn "denylist file $dl (denylist= / IAH_DENYLIST) does not exist"
    else warn "denylist: $dl_link does not resolve to $dl: bin/link-harness (from $REPO)"; fi
  fi
  n="$(find "$REPO/contexts" -mindepth 1 -maxdepth 1 -type d ! -name '_*' 2>/dev/null | wc -l | tr -d ' ')"
  [ "$n" -gt 0 ] && ok "repo $REPO: $n context(s) in contexts/" || warn "repo $REPO: no contexts/<name>/ yet (works can only go under work/global/)"
else
  warn "no repository with works detected (run from it, or set IAH_REPO)"
fi

# 3. Tools
for t in git jq gitleaks; do
  if command -v "$t" >/dev/null; then ok "$t present"; else fail "$t missing"; fi
done
command -v gh >/dev/null && ok "gh present" || warn "gh missing (only needed for GitHub work)"

# 4. Harness installed for the agents
lh_out="$(IAH_REPO="$REPO" "$HARNESS/bin/link-harness" --dry-run --quiet 2>/dev/null)"; lh_rc=$?
lh_would="$(printf '%s\n' "$lh_out" | grep '^would: ' || true)"
if [ "$lh_rc" -ne 0 ]; then fail "link-harness --dry-run failed (exit $lh_rc): run it by hand to see why"
elif [ -z "$lh_would" ]; then ok "link-harness: nothing to do"
else warn "link-harness would change $(printf '%s\n' "$lh_would" | wc -l | tr -d ' ') thing(s): run bin/link-harness
$(printf '%s\n' "$lh_would" | sed 's/^/        /')"; fi
cs="$HOME/.claude/settings.json"
ph="$HARNESS/hooks/hooks.json"
for h in ro-guard.sh block-destructive-platform.sh credential-guard.sh; do
  in_settings="$(jq -r --arg h "$h" '[.hooks.PreToolUse[]?.hooks[]?.command | select(endswith("/" + $h))] | .[0] // empty' "$cs" 2>/dev/null)"
  if plugin_mode; then
    if jq -e --arg h "$h" '[.hooks.PreToolUse[]?.hooks[]?.command | select(contains("${CLAUDE_PLUGIN_ROOT}") and endswith($h + "\""))] | length > 0' "$ph" >/dev/null 2>&1; then
      ok "hook ${h%.sh} registered by the plugin"
      [ -z "$in_settings" ] || warn "hook ${h%.sh} also in settings.json ($in_settings): runs twice"
    elif [ -n "$in_settings" ]; then
      warn "hook ${h%.sh} not in the plugin's hooks/hooks.json; only in settings.json ($in_settings)"
    else fail "hook ${h%.sh} registered nowhere (plugin hooks/hooks.json and ~/.claude/settings.json)"; fi
  elif [ -n "$in_settings" ]; then
    ok "hook $h registered in ~/.claude/settings.json"
  else fail "hook $h not registered in ~/.claude/settings.json (bin/link-harness)"; fi
done
packs="$(packs_names "$HARNESS" | paste -sd, -)"
pprof="$(profile_name)"
pperms="$(packs_profile_permissions "$HARNESS" "$pprof" 2>/dev/null || echo null)"
missing="$(jq -r --argjson b "$pperms" '(($b.deny + $b.ask) - ((.permissions.deny // []) + (.permissions.ask // []))) | length' "$cs" 2>/dev/null || echo '?')"
[ "$missing" = 0 ] && ok "deny/ask rules of the core and packs ($packs) present" || warn "$missing deny/ask rule(s) of the core and packs ($packs) missing (bin/link-harness)"
extra="$(jq -r --argjson b "$pperms" '[(.permissions.ask // [])[] | select(. as $r | $b.drop | index([$r]))] | length' "$cs" 2>/dev/null || echo '?')"
[ "$extra" = 0 ] || warn "$extra ask rule(s) of the packs still in settings.json; security profile $pprof removes them (bin/link-harness)"
# Sandbox of the strict profile (packs_sandbox): on, complete and with its Linux tools under strict; off otherwise
psb="$(packs_sandbox "$HARNESS" "$pprof" 2>/dev/null || echo null)"
sbstate="$(jq -r --argjson sb "$psb" '
  (.sandbox // {}) as $s
  | if $sb.strict then
      [ (if $s.enabled != true then "off" else empty end),
        (if $s.network.strictAllowlist != true then "domains not listed are not refused (strictAllowlist)" else empty end),
        ((($sb.domains + $sb.excluded) - (($s.network.allowedDomains // []) + ($s.excludedCommands // []))) | length
          | select(. > 0) | "\(.) domain(s) or outside command(s) missing"),
        (($sb.creds - ($s.credentials.files // [])) | length | select(. > 0) | "\(.) credential file(s) missing") ]
      | join(", ")
    elif $s.enabled == true and (($s.excludedCommands // []) | index($sb.excluded[0:1])) then "left"
    else "" end' "$cs" 2>/dev/null || echo '?')"
if [ "$pprof" = strict ]; then
  [ -z "$sbstate" ] && ok "sandbox of the strict profile on in settings.json" || warn "sandbox of the strict profile: $sbstate (bin/link-harness)"
  if [ "$(uname -s)" = Linux ]; then
    for t in ${IAH_SANDBOX_TOOLS:-bwrap socat}; do
      command -v "$t" >/dev/null 2>&1 || fail "strict needs '$t' for the sandbox; Claude Code will not start without it (failIfUnavailable): sudo apt-get install bubblewrap socat"
    done
  fi
elif [ "$sbstate" = left ]; then warn "the sandbox of strict is still on in settings.json; security profile $pprof turns it off (bin/link-harness)"; fi
[ -x "$HARNESS/bin/hooks/commit-msg" ] && ok "commit-msg hook present" || fail "bin/hooks/commit-msg missing or not executable"
command -v jq >/dev/null && ok "guards can read commands (jq)" || fail "jq missing: the guards block every command until it is installed (they fail closed)"
if [ "$RUN_TESTS" = 1 ]; then
  tlog="$(mktemp)"
  for t in tests/block-destructive.sh tests/commit-msg.sh tests/credential-guard.sh tests/fail-closed.sh tests/floor.sh tests/packs.sh tests/profile.sh tests/ro.sh "$HARNESS"/packs/*/tests.sh; do
    t="${t#"$HARNESS"/}"
    [ -f "$HARNESS/$t" ] || continue
    IAH_HOOK_LOG="$tlog" bash "$HARNESS/$t" >/dev/null 2>&1 && ok "$t green" || fail "$t failing: run it to see which case"
  done
  rm -f "$tlog"
else
  ok "tests of the guards and packs not run (doctor --tests runs them)"
fi

# 5. GitHub credentials (names and prefixes only)
if command -v gh >/dev/null; then
  gstate="$(mktemp -d)"   # the GitHub CLI writes a device id under XDG_STATE_HOME; keep that out of your home
  if XDG_STATE_HOME="$gstate" gh auth status >/dev/null 2>&1; then
    pfx="$(XDG_STATE_HOME="$gstate" gh auth status 2>&1 | sed -n 's/.*Token: \(gh[a-z]_\).*/\1/p' | head -1)"
    case "$pfx" in ghp_) warn "gh uses a CLASSIC token (ghp_): gh auth logout && gh auth login --web";; "") ok "gh logged in";; *) ok "gh logged in (token type $pfx)";; esac
  else warn "gh not logged in (gh auth login --web)"; fi
  rm -rf "$gstate"
fi
# Only where credentials are configured: shell/git/tool config files and small config dirs (no repos, no session logs).
cfg=()
for f in .zshrc .zprofile .zshenv .bash_profile .bashrc .profile .gitconfig .git-credentials .npmrc .netrc .claude.json \
         .claude/settings.json .claude/settings.local.json .copilot/config.json .copilot/mcp-config.json .docker/config.json; do
  [ -f "$HOME/$f" ] && cfg+=("$HOME/$f")
done
for d in .config/gh .config/git .config/mise .copilot/mcp .aws; do [ -d "$HOME/$d" ] && cfg+=("$HOME/$d"); done
files=""; [ "${#cfg[@]}" -gt 0 ] && files="$(grep -rIlE 'ghp_[A-Za-z0-9]{36}' "${cfg[@]}" 2>/dev/null | tr '\n' ' ')"
[ -z "$files" ] && ok "no classic token (ghp_) in config files" || warn "classic token (ghp_) found in: $files"
vars="$(env | grep -oE '^(GITHUB|GH|COPILOT)_[A-Z_]*TOKEN' | tr '\n' ' ')"
[ -z "$vars" ] && ok "no GitHub token in environment variables" || warn "token in environment variables: $vars"
helper="$(git config --get-all credential.helper | tr '\n' ' ')"; ok "git credential.helper: ${helper:-none}"

# 6. Optional modules (sourced: they use ok/warn/fail, MACHINE and HARNESS; MODULE_DIR is theirs)
for m in $(conf_modules "$REPO"); do
  if [[ ! "$m" =~ ^[a-z0-9-]+$ ]] || [ ! -d "$HARNESS/modules/$m" ]; then
    warn "module '$m' is listed in modules= but modules/$m/ does not exist"; continue
  fi
  if [ -f "$HARNESS/modules/$m/doctor.sh" ]; then
    MODULE_DIR="$HARNESS/modules/$m"
    # shellcheck source=/dev/null
    . "$MODULE_DIR/doctor.sh"
  fi
done

echo "=== bin/doctor · machine: $MACHINE · $(date '+%Y-%m-%d %H:%M')"
printf '%s\n' "${R[@]}"
n_fail="$(printf '%s\n' "${R[@]}" | grep -c '^FAIL')"; n_warn="$(printf '%s\n' "${R[@]}" | grep -c '^WARN')"
echo "=== $n_fail fail(s), $n_warn warning(s)"
[ "$n_fail" -eq 0 ]
