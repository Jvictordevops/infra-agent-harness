#!/usr/bin/env bash
# Install the harness for the agent tools of this machine. Idempotent; never removes your own settings.
#   - skills/<name>            -> ~/.claude/skills/<name> and ~/.copilot/skills (symlinks).
#     PLUGIN MODE (installed_plugins.json mentions infra-agent-harness@; IAH_PLUGIN=1|0 overrides): Claude Code
#     gets the skills from the plugin, so no links are made in ~/.claude/skills and the ones that point into a
#     harness skills/ folder are removed; Copilot still gets one link per skill. The work repo's core.hooksPath
#     is set to <stable link>/bin/hooks (IAH_STABLE_LINK, default ~/.local/share/infra-agent-harness/current,
#     kept by the plugin's SessionStart hook) when it is empty or points into a harness/plugin cache path;
#     any other custom hooksPath is left alone with a warning.
#   - GLOBAL.md of the work repo (if present) -> ~/.claude/CLAUDE.md and ~/.copilot/copilot-instructions.md
#     (work repo: $IAH_REPO, else the git repository of the current directory)
#   - hooks/settings.base.json -> merged into ~/.claude/settings.json (guards + deny/ask rules)
#   - optional modules active for the repository (.harness.conf "modules=a,b", IAH_MODULES overrides):
#     modules/<name>/link.sh is sourced and may use say/link above
#   - WSL only: COPIES of skills and GLOBAL.md into the Windows profile (%USERPROFILE%\.claude),
#     because the Windows apps cannot follow WSL symlinks. Re-run after a pull (bin/hooks/post-merge
#     and post-rewrite do it). LINK_HARNESS_WINDOWS=0 skips this part.
# Usage: link-harness [--quiet]   (bin/link-harness from a clone)
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd)"
# shellcheck source-path=SCRIPTDIR source=lib/conf.sh
. "$ROOT/bin/lib/conf.sh"
QUIET=0; [ "${1:-}" = "--quiet" ] && QUIET=1
say() { [ "$QUIET" -eq 1 ] || echo "link-harness: $*"; }
WORK="${IAH_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"   # the repo with your works

link() { # $1 target, $2 link path: create or fix a symlink, backing up a real file
  local target="$1" path="$2"
  mkdir -p "$(dirname "$path")"
  if [ -L "$path" ]; then
    [ "$(readlink "$path")" = "$target" ] && return 0
    rm -f "$path"
  elif [ -e "$path" ]; then
    mv "$path" "$path.bak-$(date +%Y%m%d%H%M%S)"; say "backed up $path"
  fi
  ln -s "$target" "$path"; say "linked $path"
}

skills() { for d in "$ROOT"/skills/*/; do [ -d "$d" ] && basename "$d"; done; }

# 1. Unix side (macOS, Linux, WSL)
if [ -n "$WORK" ] && [ -f "$WORK/GLOBAL.md" ]; then
  link "$WORK/GLOBAL.md" "$HOME/.claude/CLAUDE.md"
  link "$WORK/GLOBAL.md" "$HOME/.copilot/copilot-instructions.md"
fi
if plugin_mode; then
  say "plugin mode: skills come from the plugin"
  for n in $(skills); do # drop the old manual links (only those that point into a harness skills/ folder)
    p="$HOME/.claude/skills/$n"
    if [ -L "$p" ]; then
      t="$(readlink "$p")"
      if [ -x "$(dirname "$t")/../bin/link-harness" ]; then rm -f "$p"; say "removed $p (the plugin provides it)"; fi
    fi
  done
  # Copilot has no plugin: one link per skill, through the stable link when it exists
  if [ -L "$HOME/.copilot/skills" ] && [ "$(readlink "$HOME/.copilot/skills")" = "$HOME/.claude/skills" ]; then
    rm -f "$HOME/.copilot/skills"; say "replaced the manual-install link ~/.copilot/skills by a real folder"
  fi
  if [ -n "$(skills)" ] && [ ! -L "$HOME/.copilot/skills" ]; then
    sl="$(stable_link)"; src="$ROOT"; [ -d "$sl/skills" ] && src="$sl"
    for n in $(skills); do link "$src/skills/$n" "$HOME/.copilot/skills/$n"; done
  fi
  if [ -n "$WORK" ] && [ "$WORK" != "$ROOT" ] && git -C "$WORK" rev-parse --git-dir >/dev/null 2>&1; then
    want="$(stable_link)/bin/hooks"; hp="$(git -C "$WORK" config core.hooksPath || true)"
    case "$hp" in
      "$want") ;;
      ""|*/infra-agent-harness/bin/hooks|*/plugins/cache/*|"$ROOT/bin/hooks")
        git -C "$WORK" config core.hooksPath "$want"; say "set core.hooksPath of $WORK to $want" ;;
      *) echo "link-harness: warning: core.hooksPath of $WORK is '$hp' (left as is; plugin mode would use $want)" >&2 ;;
    esac
  fi
else
  for n in $(skills); do link "$ROOT/skills/$n" "$HOME/.claude/skills/$n"; done
  # Copilot: either ~/.copilot/skills -> ~/.claude/skills, or (if it is a real folder) one link per skill
  if [ -n "$(skills)" ]; then
    if [ ! -e "$HOME/.copilot/skills" ]; then link "$HOME/.claude/skills" "$HOME/.copilot/skills"
    elif [ ! -L "$HOME/.copilot/skills" ]; then
      for n in $(skills); do link "$HOME/.claude/skills/$n" "$HOME/.copilot/skills/$n"; done
    fi
  fi
fi

# Claude Code settings: merge hooks/settings.base.json into ~/.claude/settings.json (union of
# permissions.deny/ask; each base hook added unless a hook with the same script is already
# registered). Never removes anything; backs up the old file when it changes.
merge_settings() {
  local base="$ROOT/hooks/settings.base.json" dst="$HOME/.claude/settings.json" new fresh=0 hroot="$ROOT"
  # Plugin mode: $ROOT is the versioned cache directory, deleted some days after an update. Hook commands
  # must use the stable link, or the guards would silently stop running after the next update.
  if plugin_mode; then hroot="$(stable_link)"; fi
  command -v jq >/dev/null || { say "jq missing: settings not merged"; return 0; }
  mkdir -p "$(dirname "$dst")"; [ -s "$dst" ] || { echo '{}' > "$dst"; fresh=1; }
  new="$(jq --arg root "$hroot" --slurpfile b "$base" '
    ($b[0] | del(._comment) | walk(if type == "string" then gsub("__ROOT__"; $root) else . end)) as $base
    | .permissions.deny = ((.permissions.deny // []) + ($base.permissions.deny - (.permissions.deny // [])))
    | .permissions.ask  = ((.permissions.ask  // []) + ($base.permissions.ask  - (.permissions.ask  // [])))
    | reduce ($base.hooks.PreToolUse[] | .matcher as $m | .hooks[] | {m: $m, h: .}) as $x (.;
        ($x.h.command | split("/") | last) as $script
        | if [(.hooks.PreToolUse // [])[] | .hooks[]? | .command | split("/") | last] | index($script)
          then .
          else .hooks.PreToolUse = ((.hooks.PreToolUse // []) + [{matcher: $x.m, hooks: [$x.h]}])
          end)
  ' "$dst")" || { say "cannot parse $dst: settings not merged"; return 0; }
  if [ "$new" != "$(jq . "$dst")" ]; then
    [ "$fresh" = 1 ] || cp "$dst" "$dst.bak-$(date +%Y%m%d%H%M%S)"
    printf '%s\n' "$new" > "$dst"; say "merged hooks/settings.base.json into $dst"
  fi
}
merge_settings

# Optional modules: sourced, so they can use say/link and the variables above (MODULE_DIR is theirs)
for m in $(conf_modules "$WORK"); do
  if [[ ! "$m" =~ ^[a-z0-9-]+$ ]] || [ ! -d "$ROOT/modules/$m" ]; then
    echo "link-harness: warning: unknown module '$m' (no modules/$m/)" >&2; continue
  fi
  if [ -f "$ROOT/modules/$m/link.sh" ]; then
    MODULE_DIR="$ROOT/modules/$m"
    # shellcheck source=/dev/null
    . "$MODULE_DIR/link.sh"
  fi
done

# 2. Windows profile of the Claude app (only from WSL)
if [ "${LINK_HARNESS_WINDOWS:-1}" = 1 ] && grep -qi microsoft /proc/version 2>/dev/null; then
  winprof="$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')"
  [ -n "$winprof" ] || { say "cannot resolve %USERPROFILE%; Windows side skipped"; exit 0; }
  wc="$(wslpath "$winprof")/.claude"
  mkdir -p "$wc/skills"
  if [ -n "$WORK" ] && [ -f "$WORK/GLOBAL.md" ]; then
    { echo "<!-- Generated by infra-agent-harness/bin/link-harness from GLOBAL.md. Do not edit here. -->"
      cat "$WORK/GLOBAL.md"; } > "$wc/CLAUDE.md.new"
    if ! cmp -s "$wc/CLAUDE.md.new" "$wc/CLAUDE.md" 2>/dev/null; then
      [ -e "$wc/CLAUDE.md" ] && ! head -1 "$wc/CLAUDE.md" | grep -q "link-harness" && cp "$wc/CLAUDE.md" "$wc/CLAUDE.md.bak-$(date +%Y%m%d%H%M%S)"
      mv "$wc/CLAUDE.md.new" "$wc/CLAUDE.md"; say "updated Windows CLAUDE.md"
    else rm -f "$wc/CLAUDE.md.new"; fi
  fi
  for n in $(skills); do
    mkdir -p "$wc/skills/$n"
    if ! diff -rq "$ROOT/skills/$n" "$wc/skills/$n" >/dev/null 2>&1; then
      rm -rf "$wc/skills/$n"; cp -r "$ROOT/skills/$n" "$wc/skills/$n"; say "copied skill $n to Windows"
    fi
  done
fi
say "done"
