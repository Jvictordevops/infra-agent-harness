#!/usr/bin/env bash
# Install the harness for the agent tools of this machine. Idempotent; never removes your own settings.
#   - skills/<name>            -> ~/.claude/skills/<name> and ~/.copilot/skills (symlinks)
#   - GLOBAL.md (if present)   -> ~/.claude/CLAUDE.md and ~/.copilot/copilot-instructions.md
#   - hooks/settings.base.json -> merged into ~/.claude/settings.json (guards + deny/ask rules)
#   - WSL only: COPIES of skills and GLOBAL.md into the Windows profile (%USERPROFILE%\.claude),
#     because the Windows apps cannot follow WSL symlinks. Re-run after a pull (bin/hooks/post-merge
#     and post-rewrite do it). LINK_HARNESS_WINDOWS=0 skips this part.
# Usage: bin/link-harness [--quiet]
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd)"
QUIET=0; [ "${1:-}" = "--quiet" ] && QUIET=1
say() { [ "$QUIET" -eq 1 ] || echo "link-harness: $*"; }

link() { # $1 target, $2 link path: create or fix a symlink, backing up a real file
  local target="$1" path="$2"
  mkdir -p "$(dirname "$path")"
  if [ -L "$path" ]; then
    [ "$(readlink "$path")" = "$target" ] && return 0
    rm -f "$path"
  elif [ -e "$path" ]; then
    mv "$path" "$path.bak-$(date +%Y%m%d%H%M%S)"; say "backed up $path"
  fi
  ln -s "$target" "$path"; say "linked $path"
}

skills() { for d in "$ROOT"/skills/*/; do [ -d "$d" ] && basename "$d"; done; }

# 1. Unix side (macOS, Linux, WSL)
if [ -f "$ROOT/GLOBAL.md" ]; then
  link "$ROOT/GLOBAL.md" "$HOME/.claude/CLAUDE.md"
  link "$ROOT/GLOBAL.md" "$HOME/.copilot/copilot-instructions.md"
fi
for n in $(skills); do link "$ROOT/skills/$n" "$HOME/.claude/skills/$n"; done
# Copilot: either ~/.copilot/skills -> ~/.claude/skills, or (if it is a real folder) one link per skill
if [ -n "$(skills)" ]; then
  if [ ! -e "$HOME/.copilot/skills" ]; then link "$HOME/.claude/skills" "$HOME/.copilot/skills"
  elif [ ! -L "$HOME/.copilot/skills" ]; then
    for n in $(skills); do link "$HOME/.claude/skills/$n" "$HOME/.copilot/skills/$n"; done
  fi
fi

# Claude Code settings: merge hooks/settings.base.json into ~/.claude/settings.json (union of
# permissions.deny/ask; each base hook added unless a hook with the same script is already
# registered). Never removes anything; backs up the old file when it changes.
merge_settings() {
  local base="$ROOT/hooks/settings.base.json" dst="$HOME/.claude/settings.json" new fresh=0
  command -v jq >/dev/null || { say "jq missing: settings not merged"; return 0; }
  mkdir -p "$(dirname "$dst")"; [ -s "$dst" ] || { echo '{}' > "$dst"; fresh=1; }
  new="$(jq --arg root "$ROOT" --slurpfile b "$base" '
    ($b[0] | del(._comment) | walk(if type == "string" then gsub("__ROOT__"; $root) else . end)) as $base
    | .permissions.deny = ((.permissions.deny // []) + ($base.permissions.deny - (.permissions.deny // [])))
    | .permissions.ask  = ((.permissions.ask  // []) + ($base.permissions.ask  - (.permissions.ask  // [])))
    | reduce ($base.hooks.PreToolUse[] | .matcher as $m | .hooks[] | {m: $m, h: .}) as $x (.;
        ($x.h.command | split("/") | last) as $script
        | if [(.hooks.PreToolUse // [])[] | .hooks[]? | .command | split("/") | last] | index($script)
          then .
          else .hooks.PreToolUse = ((.hooks.PreToolUse // []) + [{matcher: $x.m, hooks: [$x.h]}])
          end)
  ' "$dst")" || { say "cannot parse $dst: settings not merged"; return 0; }
  if [ "$new" != "$(jq . "$dst")" ]; then
    [ "$fresh" = 1 ] || cp "$dst" "$dst.bak-$(date +%Y%m%d%H%M%S)"
    printf '%s\n' "$new" > "$dst"; say "merged hooks/settings.base.json into $dst"
  fi
}
merge_settings

# 2. Windows profile of the Claude app (only from WSL)
if [ "${LINK_HARNESS_WINDOWS:-1}" = 1 ] && grep -qi microsoft /proc/version 2>/dev/null; then
  winprof="$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')"
  [ -n "$winprof" ] || { say "cannot resolve %USERPROFILE%; Windows side skipped"; exit 0; }
  wc="$(wslpath "$winprof")/.claude"
  mkdir -p "$wc/skills"
  if [ -f "$ROOT/GLOBAL.md" ]; then
    { echo "<!-- Generated by infra-agent-harness/bin/link-harness from GLOBAL.md. Do not edit here. -->"
      cat "$ROOT/GLOBAL.md"; } > "$wc/CLAUDE.md.new"
    if ! cmp -s "$wc/CLAUDE.md.new" "$wc/CLAUDE.md" 2>/dev/null; then
      [ -e "$wc/CLAUDE.md" ] && ! head -1 "$wc/CLAUDE.md" | grep -q "link-harness" && cp "$wc/CLAUDE.md" "$wc/CLAUDE.md.bak-$(date +%Y%m%d%H%M%S)"
      mv "$wc/CLAUDE.md.new" "$wc/CLAUDE.md"; say "updated Windows CLAUDE.md"
    else rm -f "$wc/CLAUDE.md.new"; fi
  fi
  for n in $(skills); do
    mkdir -p "$wc/skills/$n"
    if ! diff -rq "$ROOT/skills/$n" "$wc/skills/$n" >/dev/null 2>&1; then
      rm -rf "$wc/skills/$n"; cp -r "$ROOT/skills/$n" "$wc/skills/$n"; say "copied skill $n to Windows"
    fi
  done
fi
say "done"
