#!/usr/bin/env bash
# Install the harness for the agent tools of this machine. Idempotent; never removes your own settings.
#   - skills/<name>            -> ~/.claude/skills/<name> and ~/.copilot/skills (symlinks).
#     PLUGIN MODE (installed_plugins.json mentions infra-agent-harness@; IAH_PLUGIN=1|0 overrides): Claude Code
#     gets the skills from the plugin, so no links are made in ~/.claude/skills and the links that point into
#     THIS harness (a folder whose .claude-plugin/plugin.json is named infra-agent-harness) are removed; links
#     into any other harness are kept (the plugin's skill is then also available as infra-agent-harness:<n>).
#     Copilot still gets one link per skill, always through the stable link (never the versioned plugin cache
#     dir, deleted on update); a Copilot link that belongs to another harness is left alone. The work repo's core.hooksPath
#     is set to <stable link>/bin/hooks (IAH_STABLE_LINK, default ~/.local/share/infra-agent-harness/current,
#     kept by the plugin's SessionStart hook) when it is empty or points into a harness/plugin cache path;
#     any other custom hooksPath is left alone with a warning.
#   - GLOBAL.md of the work repo (if present) -> ~/.claude/CLAUDE.md and ~/.copilot/copilot-instructions.md
#     (work repo: $IAH_REPO, else the git repository of the current directory)
#   - denylist= of the work repo's .harness.conf (path relative to the repo; IAH_DENYLIST overrides) ->
#     ~/.config/infra-agent-harness/denylist.txt becomes a symlink to that file, which bin/denylist-scan reads. A
#     different link or a regular file is backed up (with a warning) first; unset key or missing file: nothing.
#   - hooks/settings.base.json + packs/*/permissions.json -> merged into ~/.claude/settings.json (guards + deny/ask
#     rules of the core and of every pack). Plugin mode: only deny/ask (the plugin's hooks/hooks.json registers the
#     guards); stable-link guard entries of older runs are removed.
#   - optional modules active for the repository (.harness.conf "modules=a,b", IAH_MODULES overrides):
#     modules/<name>/link.sh is sourced and may use say/link above
#   - WSL only: COPIES of skills and GLOBAL.md into the Windows profile (%USERPROFILE%\.claude),
#     because the Windows apps cannot follow WSL symlinks. Re-run after a pull (bin/hooks/post-merge
#     and post-rewrite do it). LINK_HARNESS_WINDOWS=0 skips this part. In plugin mode the skills are NOT
#     copied (install the plugin from the Windows side); only GLOBAL.md is.
# Usage: link-harness [--quiet] [--dry-run]   (bin/link-harness from a clone)
#   --dry-run prints "would: <action>" for everything it would change and writes nothing (bin/doctor uses it).
# IAH_PROC_VERSION overrides the file used to detect WSL (/proc/version); only tests need it.
# shellcheck disable=SC2088   # "~" in messages is literal text
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd)"
# shellcheck source-path=SCRIPTDIR source=lib/conf.sh
. "$ROOT/bin/lib/conf.sh"
# shellcheck source-path=SCRIPTDIR source=lib/packs.sh
. "$ROOT/bin/lib/packs.sh"
# shellcheck source-path=SCRIPTDIR source=lib/profile.sh
. "$ROOT/bin/lib/profile.sh"
QUIET=0; DRY_RUN=0
for a in "$@"; do
  case "$a" in
    --quiet) QUIET=1 ;;
    --dry-run) DRY_RUN=1 ;;
    *) echo "usage: link-harness [--quiet] [--dry-run]" >&2; exit 2 ;;
  esac
done
export DRY_RUN
say() { [ "$QUIET" -eq 1 ] || echo "link-harness: $*"; }
would() { echo "would: $*"; }   # dry-run only; printed even with --quiet
WORK="${IAH_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"   # the repo with your works

link() { # $1 target, $2 link path: create or fix a symlink, backing up a real file
  local target="$1" path="$2"
  if [ -L "$path" ]; then
    [ "$(readlink "$path")" = "$target" ] && return 0
    if [ "$DRY_RUN" = 1 ]; then would "relink $path -> $target"; return 0; fi
    rm -f "$path"
  elif [ -e "$path" ]; then
    if [ "$DRY_RUN" = 1 ]; then would "back up $path and link it -> $target"; return 0; fi
    mv "$path" "$path.bak-$(date +%Y%m%d%H%M%S)"; say "backed up $path"
  elif [ "$DRY_RUN" = 1 ]; then would "link $path -> $target"; return 0
  fi
  mkdir -p "$(dirname "$path")"
  ln -s "$target" "$path"; say "linked $path"
}

# is_this_harness <harness root>: exit 0 when <root>/.claude-plugin/plugin.json is named infra-agent-harness
is_this_harness() {
  local pj="$1/.claude-plugin/plugin.json" nm
  [ -f "$pj" ] || return 1
  if command -v jq >/dev/null 2>&1; then nm="$(jq -r '.name // empty' "$pj" 2>/dev/null || true)"
  else nm="$(sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pj" | head -1)"; fi
  [ "$nm" = infra-agent-harness ]
}

# link_is_ours <link path>: the link points into this harness: a folder named infra-agent-harness in
# plugin.json, or a (possibly already deleted) version dir of this plugin in the plugin cache
link_is_ours() {
  case "$(readlink "$1")" in */plugins/cache/*/infra-agent-harness/*) return 0 ;; esac
  is_this_harness "$(link_root "$1")"
}

# link_root <link path> -> harness root implied by the link target (<root>/skills/<n>)
link_root() {
  local t; t="$(readlink "$1")"
  case "$t" in /*) ;; *) t="$(dirname "$1")/$t" ;; esac
  printf '%s' "$(dirname "$t")/.."
}

skills() { for d in "$ROOT"/skills/*/; do [ -d "$d" ] && basename "$d"; done; }

# 1. Unix side (macOS, Linux, WSL)
if [ -n "$WORK" ] && [ -f "$WORK/GLOBAL.md" ]; then
  link "$WORK/GLOBAL.md" "$HOME/.claude/CLAUDE.md"
  link "$WORK/GLOBAL.md" "$HOME/.copilot/copilot-instructions.md"
fi
# Private denylist: ~/.config/infra-agent-harness/denylist.txt -> the file named by denylist= (the default
# path of bin/denylist-scan). Never links the path to itself (IAH_DENYLIST may name it).
DL="$(conf_denylist "$WORK")"
DL_LINK="$HOME/.config/infra-agent-harness/denylist.txt"
if [ -n "$DL" ] && [ "$DL" != "$DL_LINK" ]; then
  if [ ! -f "$DL" ]; then
    echo "link-harness: warning: denylist file $DL does not exist; $DL_LINK not linked" >&2
  else
    DL="$(cd "$(dirname "$DL")" && pwd)/$(basename "$DL")"
    if [ -L "$DL_LINK" ] && [ "$(readlink "$DL_LINK")" = "$DL" ]; then :
    elif [ -L "$DL_LINK" ] || [ -e "$DL_LINK" ]; then
      echo "link-harness: warning: $DL_LINK is not a link to $DL; backing it up and replacing it" >&2
      if [ "$DRY_RUN" = 1 ]; then would "back up $DL_LINK and link it -> $DL"
      else
        mv "$DL_LINK" "$DL_LINK.bak-$(date +%Y%m%d%H%M%S)"; say "backed up $DL_LINK"
        ln -s "$DL" "$DL_LINK"; say "linked $DL_LINK"
      fi
    else link "$DL" "$DL_LINK"; fi
  fi
fi
KEPT=" "   # skill names whose ~/.claude/skills/<n> link was kept because it is not this harness's
if plugin_mode; then
  say "plugin mode: skills come from the plugin"
  for n in $(skills); do # drop the old manual links, but only those that belong to this harness
    p="$HOME/.claude/skills/$n"
    if [ -L "$p" ]; then
      if link_is_ours "$p"; then
        if [ "$DRY_RUN" = 1 ]; then would "remove $p (the plugin provides it)"
        else rm -f "$p"; say "removed $p (the plugin provides it)"; fi
      else
        KEPT="$KEPT$n "
        say "kept $p -> $(readlink "$p") (not this harness; the plugin's skill is available as infra-agent-harness:$n)"
      fi
    fi
  done
  # Copilot has no plugin: one link per skill, always through the stable link (the versioned cache dir
  # is deleted on update). A link of another harness is never replaced.
  sl="$(stable_link)"; cs="$HOME/.copilot/skills"; cs_link=0
  if [ -L "$cs" ]; then
    cs_link=1
    if [ "$(readlink "$cs")" = "$HOME/.claude/skills" ]; then
      if [ "$KEPT" != " " ]; then
        say "~/.copilot/skills -> ~/.claude/skills left as is: Copilot keeps using ~/.claude/skills (it holds links of another harness)"
      else
        if [ "$DRY_RUN" = 1 ]; then would "replace the manual-install link ~/.copilot/skills by a real folder"
        else rm -f "$cs"; say "replaced the manual-install link ~/.copilot/skills by a real folder"; fi
        cs_link=0
      fi
    else
      say "~/.copilot/skills is a link to $(readlink "$cs"), left as is"
    fi
  fi
  if [ -n "$(skills)" ] && [ "$cs_link" = 0 ]; then
    [ -d "$sl/skills" ] || echo "link-harness: warning: stable link $sl does not exist yet; the Copilot skill links resolve after the first Claude Code session (its SessionStart hook creates it)" >&2
    for n in $(skills); do
      cp_="$cs/$n"; want="$sl/skills/$n"
      if [ -L "$cp_" ]; then
        cur="$(readlink "$cp_")"
        # replace only a link of this harness: stable path, this harness root, or its manual-install link
        if [ "$cur" != "$want" ] && ! { case "$cur" in "$sl"/*) true ;; "$HOME/.claude/skills/$n") case "$KEPT" in *" $n "*) false ;; *) true ;; esac ;; *) link_is_ours "$cp_" ;; esac; }; then
          say "kept $cp_ -> $cur (not this harness)"; continue
        fi
      elif [ -e "$cp_" ]; then
        say "kept $cp_ (not a link; not touched)"; continue
      fi
      link "$want" "$cp_"
    done
  fi
  if [ -n "$WORK" ] && [ "$WORK" != "$ROOT" ] && git -C "$WORK" rev-parse --git-dir >/dev/null 2>&1; then
    want="$(stable_link)/bin/hooks"; hp="$(git -C "$WORK" config core.hooksPath || true)"
    case "$hp" in
      "$want") ;;
      ""|*/infra-agent-harness/bin/hooks|*/plugins/cache/*|"$ROOT/bin/hooks")
        if [ "$DRY_RUN" = 1 ]; then would "set core.hooksPath of $WORK to $want"
        else git -C "$WORK" config core.hooksPath "$want"; say "set core.hooksPath of $WORK to $want"; fi ;;
      *) echo "link-harness: warning: core.hooksPath of $WORK is '$hp' (left as is; plugin mode would use $want)" >&2 ;;
    esac
  fi
else
  for n in $(skills); do link "$ROOT/skills/$n" "$HOME/.claude/skills/$n"; done
  # Copilot: either ~/.copilot/skills -> ~/.claude/skills, or (if it is a real folder) one link per skill
  if [ -n "$(skills)" ]; then
    if [ ! -e "$HOME/.copilot/skills" ]; then link "$HOME/.claude/skills" "$HOME/.copilot/skills"
    elif [ ! -L "$HOME/.copilot/skills" ]; then
      for n in $(skills); do link "$HOME/.claude/skills/$n" "$HOME/.copilot/skills/$n"; done
    fi
  fi
fi

# Claude Code settings: merge hooks/settings.base.json into ~/.claude/settings.json (union of
# permissions.deny/ask, together with those of packs/*/permissions.json; each base hook added unless a hook
# with the same script is already registered). Backs up the old file when it changes.
# PLUGIN MODE: only permissions.deny/ask are merged (plugins cannot ship permission rules); the guard hooks
# come from the plugin's hooks/hooks.json, so none are added, and the entries an earlier plugin-mode run
# added (exactly <stable link>/hooks/<guard>/<guard>.sh) are removed, or they would run twice. A guard entry
# that points anywhere else (another harness) is kept with a message.
# SECURITY PROFILE (bin/lib/profile.sh): permissive removes the ask rules of the packs (exact matches, also one
# the user wrote by hand) and lists each one; going back to standard or strict adds them again. Deny rules and
# the core asks (git) are the same in every profile.
# SANDBOX (bin/lib/packs.sh packs_sandbox): strict turns the sandbox on (failIfUnavailable, no unsandboxed
# retry), adds the commands that run outside it, the domains of the core and the chosen packs (and takes back
# those of the packs not chosen) and denies every credential file inside it. Any other profile takes back what
# strict adds, by exact match, also a value the user wrote by hand (enabled: true included), and names it; the
# user's own domains, commands and files stay. Same in plugin mode and manual install.
# shellcheck disable=SC2016  # a jq program: its $ are jq's
SANDBOX_JQ='
  def prune(p): if (getpath(p) // null) == [] or (getpath(p) // null) == {} then delpaths([p]) else . end;
  if $sb.strict then
    .sandbox.enabled = true | .sandbox.failIfUnavailable = true | .sandbox.allowUnsandboxedCommands = false
    | .sandbox.excludedCommands = ((.sandbox.excludedCommands // []) as $e | $e + ($sb.excluded - $e))
    | .sandbox.network.allowedDomains = (((.sandbox.network.allowedDomains // []) - ($sb.all_domains - $sb.domains)) as $d
                                         | $d + ($sb.domains - $d))
    | .sandbox.credentials.files = ((.sandbox.credentials.files // []) as $f | $f + ($sb.creds - $f))
  elif (.sandbox | type) == "object" then
    (if .sandbox.enabled == true then del(.sandbox.enabled) else . end)
    | (if .sandbox.failIfUnavailable == true then del(.sandbox.failIfUnavailable) else . end)
    | (if .sandbox.allowUnsandboxedCommands == false then del(.sandbox.allowUnsandboxedCommands) else . end)
    | (if .sandbox.excludedCommands then .sandbox.excludedCommands -= $sb.excluded else . end)
    | (if .sandbox.network.allowedDomains then .sandbox.network.allowedDomains -= $sb.all_domains else . end)
    | (if .sandbox.credentials.files then .sandbox.credentials.files -= $sb.creds else . end)
    | prune(["sandbox", "excludedCommands"]) | prune(["sandbox", "network", "allowedDomains"])
    | prune(["sandbox", "network"]) | prune(["sandbox", "credentials", "files"]) | prune(["sandbox", "credentials"])
    | prune(["sandbox"])
  else . end'

# Names what the sandbox merge changes: $1 settings before, $2 settings after (JSON text), $3 profile, $4 packs_sandbox
sandbox_messages() {
  local kind v
  while IFS=$'\t' read -r kind v; do
    case "$kind" in
      on) v="enable the sandbox (security profile $3): $v" ;;
      off) v="disable the sandbox (security profile $3: the sandbox comes with strict)" ;;
      domain) v="remove allowed domain $v from the sandbox ($([ "$(jq -r .strict <<<"$4")" = true ] && echo 'its pack is not chosen' || echo "security profile $3"))" ;;
      excluded) v="remove $v from the commands outside the sandbox (security profile $3)" ;;
      creds) v="remove $v credential file(s) from the sandbox deny list (security profile $3)" ;;
      *) continue ;;
    esac
    if [ "$DRY_RUN" = 1 ]; then would "$v"
    else v="${v/#enable /enabling }"; v="${v/#disable /disabling }"; say "${v/#remove /removing }"; fi
  done < <(jq -r --argjson n "$2" '
    (.sandbox // {}) as $o | ($n.sandbox // {}) as $w
    | (if ($o.enabled != true) and ($w.enabled == true) then
         "on\t\(($w.network.allowedDomains // []) | length) allowed domain(s), \(($w.credentials.files // []) | length) credential file(s) denied inside it, outside it: \(($w.excludedCommands // []) | join(", "))"
       else empty end),
      (if ($o.enabled == true) and ($w.enabled != true) then "off\t" else empty end),
      ((($o.network.allowedDomains // []) - ($w.network.allowedDomains // []))[] | "domain\t" + .),
      ((($o.excludedCommands // []) - ($w.excludedCommands // []))[] | "excluded\t" + .),
      ((($o.credentials.files // []) - ($w.credentials.files // [])) | length | select(. > 0) | "creds\t" + tostring)
  ' "$1" 2>/dev/null || true)
}

merge_settings() {
  local base="$ROOT/hooks/settings.base.json" dst="$HOME/.claude/settings.json" new fresh=0 hroot="$ROOT" src
  local plug=0 drop='[]' c perms prof r sb
  # Plugin mode: $ROOT is the versioned cache directory, deleted some days after an update. Hook commands
  # (manual mode only) and the entries to remove use the stable link.
  if plugin_mode; then plug=1; hroot="$(stable_link)"; fi
  command -v jq >/dev/null || { say "jq missing: settings not merged"; return 0; }
  prof="$(profile_name)"
  perms="$(packs_profile_permissions "$ROOT" "$prof")" || { say "cannot read the deny/ask rules of the core and packs: settings not merged"; return 0; }
  sb="$(packs_sandbox "$ROOT" "$prof")" || { say "cannot read the sandbox of the core and packs: settings not merged"; return 0; }
  src="$dst"
  if [ ! -s "$dst" ]; then
    fresh=1
    if [ "$DRY_RUN" = 1 ]; then src="$(mktemp)"; echo '{}' > "$src"
    else mkdir -p "$(dirname "$dst")"; echo '{}' > "$dst"; fi
  elif [ "$plug" = 1 ]; then
    drop="$(jq -c --arg root "$hroot" '[$root + "/hooks/ro-guard/ro-guard.sh", $root + "/hooks/block-destructive-platform/block-destructive-platform.sh", $root + "/hooks/credential-guard/credential-guard.sh"]' <<<'null')"
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      if jq -e --arg c "$c" 'index($c)' <<<"$drop" >/dev/null; then
        if [ "$DRY_RUN" = 1 ]; then would "remove hook $c from settings.json (the plugin registers it)"
        else say "removing hook $c from settings.json (the plugin registers it)"; fi
      else
        say "kept hook $c in settings.json (not this harness; the guard will run twice: the plugin also registers it)"
      fi
    done < <(jq -r '.hooks.PreToolUse[]?.hooks[]?.command // empty | select(endswith("/ro-guard.sh") or endswith("/block-destructive-platform.sh") or endswith("/credential-guard.sh"))' "$dst" 2>/dev/null || true)
  fi
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    if [ "$DRY_RUN" = 1 ]; then would "remove ask rule $r from settings.json (security profile $prof)"
    else say "removing ask rule $r from settings.json (security profile $prof)"; fi
  done < <(jq -r --argjson perms "$perms" '(.permissions.ask // [])[] | select(. as $r | $perms.drop | index([$r]))' "$src" 2>/dev/null || true)
  new="$(jq --arg root "$hroot" --argjson plug "$plug" --argjson drop "$drop" --argjson perms "$perms" --slurpfile b "$base" '
    ($b[0] | del(._comment) | walk(if type == "string" then gsub("__ROOT__"; $root) else . end)) as $base
    | .permissions.deny = ((.permissions.deny // []) + ($perms.deny - (.permissions.deny // [])))
    | .permissions.ask  = (((.permissions.ask // []) - $perms.drop) as $a | $a + ($perms.ask - $a))
    | if $plug == 1 then
        if (.hooks.PreToolUse | type) == "array" then
          .hooks.PreToolUse |= map(
            if any(.hooks[]?; (.command? // "") as $c | $drop | index($c))
            then (.hooks |= map(select((.command? // "") as $c | ($drop | index($c)) | not))) | select(.hooks | length > 0)
            else . end)
          | if (.hooks.PreToolUse | length) == 0 then del(.hooks.PreToolUse) else . end
          | if (.hooks | length) == 0 then del(.hooks) else . end
        else . end
      else
        reduce ($base.hooks.PreToolUse[] | .matcher as $m | .hooks[] | {m: $m, h: .}) as $x (.;
          ($x.h.command | split("/") | last) as $script
          | if [(.hooks.PreToolUse // [])[] | .hooks[]? | .command | split("/") | last] | index($script)
            then .
            else .hooks.PreToolUse = ((.hooks.PreToolUse // []) + [{matcher: $x.m, hooks: [$x.h]}])
            end)
      end
  ' "$src")" || { say "cannot parse $dst: settings not merged"; [ "$src" = "$dst" ] || rm -f "$src"; return 0; }
  new="$(jq --argjson sb "$sb" "$SANDBOX_JQ" <<<"$new")" || { say "cannot merge the sandbox block: settings not merged"; [ "$src" = "$dst" ] || rm -f "$src"; return 0; }
  sandbox_messages "$src" "$new" "$prof" "$sb"
  if [ "$new" != "$(jq . "$src")" ]; then
    if [ "$DRY_RUN" = 1 ]; then
      if [ "$plug" = 1 ]; then would "merge permissions of hooks/settings.base.json into $dst"
      else would "merge hooks/settings.base.json into $dst"; fi
    else
      [ "$fresh" = 1 ] || cp "$dst" "$dst.bak-$(date +%Y%m%d%H%M%S)"
      printf '%s\n' "$new" > "$dst"
      if [ "$plug" = 1 ]; then say "merged permissions of hooks/settings.base.json into $dst"
      else say "merged hooks/settings.base.json into $dst"; fi
    fi
  fi
  [ "$src" = "$dst" ] || rm -f "$src"
}
merge_settings

# Optional modules: sourced, so they can use say/link and the variables above (MODULE_DIR is theirs).
# MODULE_LINK_DIR is the path to write into links and files outside the harness: in plugin mode it goes through
# the stable link, because the versioned plugin cache dir is deleted after an update.
for m in $(conf_modules "$WORK"); do
  if [[ ! "$m" =~ ^[a-z0-9-]+$ ]] || [ ! -d "$ROOT/modules/$m" ]; then
    echo "link-harness: warning: unknown module '$m' (no modules/$m/)" >&2; continue
  fi
  if [ -f "$ROOT/modules/$m/link.sh" ]; then
    MODULE_DIR="$ROOT/modules/$m"
    # shellcheck disable=SC2034  # read by the sourced modules/<m>/link.sh
    if plugin_mode; then MODULE_LINK_DIR="$(stable_link)/modules/$m"; else MODULE_LINK_DIR="$MODULE_DIR"; fi
    # shellcheck source=/dev/null
    . "$MODULE_DIR/link.sh" || echo "link-harness: warning: module $m: link.sh ended with an error; continuing" >&2
  fi
done

# 2. Windows profile of the Claude app (only from WSL)
if [ "${LINK_HARNESS_WINDOWS:-1}" = 1 ] && grep -qi microsoft "${IAH_PROC_VERSION:-/proc/version}" 2>/dev/null; then
  winprof="$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r' || true)"
  [ -n "$winprof" ] || { say "cannot resolve %USERPROFILE%; Windows side skipped"; exit 0; }
  wc="$(wslpath "$winprof")/.claude"
  if [ -n "$WORK" ] && [ -f "$WORK/GLOBAL.md" ]; then
    gen() { echo "<!-- Generated by infra-agent-harness/bin/link-harness from GLOBAL.md. Do not edit here. -->"; cat "$WORK/GLOBAL.md"; }
    if [ "$DRY_RUN" = 1 ]; then
      gen | cmp -s - "$wc/CLAUDE.md" 2>/dev/null || would "write Windows CLAUDE.md ($wc/CLAUDE.md) from $WORK/GLOBAL.md"
    else
      mkdir -p "$wc"; gen > "$wc/CLAUDE.md.new"
      if ! cmp -s "$wc/CLAUDE.md.new" "$wc/CLAUDE.md" 2>/dev/null; then
        if [ -e "$wc/CLAUDE.md" ] && ! head -1 "$wc/CLAUDE.md" | grep -q "link-harness"; then cp "$wc/CLAUDE.md" "$wc/CLAUDE.md.bak-$(date +%Y%m%d%H%M%S)"; fi
        mv "$wc/CLAUDE.md.new" "$wc/CLAUDE.md"; say "updated Windows CLAUDE.md"
      else rm -f "$wc/CLAUDE.md.new"; fi
    fi
  fi
  if plugin_mode; then
    say "plugin mode: skills are not copied to Windows; install the plugin from the Windows side (claude plugin marketplace add Jvictordevops/infra-agent-harness; claude plugin install infra-agent-harness@infra-agent-harness)"
  else
    for n in $(skills); do
      if ! diff -rq "$ROOT/skills/$n" "$wc/skills/$n" >/dev/null 2>&1; then
        if [ "$DRY_RUN" = 1 ]; then would "copy skill $n to Windows ($wc/skills/$n)"
        else mkdir -p "$wc/skills/$n"; rm -rf "$wc/skills/$n"; cp -r "$ROOT/skills/$n" "$wc/skills/$n"; say "copied skill $n to Windows"; fi
      fi
    done
  fi
fi
say "done"
