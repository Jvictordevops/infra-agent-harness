#!/usr/bin/env bash
# Read-only executor (docs/tools.md): runs ONE allow-listed read-only command, here or on
# another machine over SSH, for executors and their sub-agents. Cloud roles are usually admin, so the
# guard is ours: this allow-list + the ro-guard hook (hooks/ro-guard), which in read-only mode blocks
# aws/kubectl/helm/ssh… that do not go through bin/ro.
#
# Usage: bin/ro [--host <ssh-alias>] [--check] <tool> <args…>
#   --host   run on that machine (its own copy of bin/ro ($RO_REMOTE_BIN, default ~/infra-agent-harness/bin/ro) validates again, with its paths)
#   --check  validate only: prints "ok" or the reason, runs nothing
#   bin/ro mode on [reason] | status     read-only mode on this machine (the hook enforces it)
#   bin/ro mode off                      only the user, from a terminal (the hook blocks agents)
# Tools (fixed shape, so the check is simple); aws, kubectl and helm come from packs/<name>/ro.sh:
#   aws <service> <operation> … --profile P       describe-/list-/get-/batch-get-/lookup-/search-, s3 ls
#   kubectl <verb> … --context C                  get, describe, logs, top, events, api-resources, auth can-i…
#   helm <list|status|history|get metadata> … --kube-context C
#   git -C <dir> <log|show|diff|grep|status|branch…> …
#   gh <repo|pr|issue|run|workflow|release|label|search> <list|view|…> … · gh api <endpoint> (GET only)
#   cat|head|tail|ls|find|grep|wc|stat <paths under RO_ROOTS>
# Limits (optional, comma lists): RO_PROFILES, RO_CONTEXTS · RO_ROOTS (default $HOME/code).
# Never: secrets (Secrets, get-secret-value, --with-decryption, tokens), credentials, sensitive files.
# No shell inside: no pipes, redirections or chaining; filter the output locally (jq, grep).
set -euo pipefail
set -f

MODE="${RO_MODE_FILE:-$HOME/.config/infra-agent-harness/ro-mode}"
# The harness root, through the ~/.local/bin/ro link and the stable link: the packs live there
HARNESS="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd)"
CORE_TOOLS="git gh cat head tail ls find grep wc stat"
PACK_TOOLS=""

usage() { sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
deny() { echo "ro: denied: $*" >&2; exit 3; }

in_list() { # $1 value, $2 comma list (empty = any)
  [ -z "${2-}" ] && return 0
  case ",$2," in *",$1,"*) return 0 ;; esac
  return 1
}

opt_val() { # $1 option, rest args -> value of "--opt X" or "--opt=X"
  local o="$1"; shift
  while [ $# -gt 0 ]; do
    case "$1" in
      "$o") echo "${2-}"; return 0 ;;
      "$o="*) echo "${1#*=}"; return 0 ;;
    esac
    shift
  done
  return 1
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

check_path() { # $1 path; REMOTE=1 -> textual checks only (the other machine resolves it)
  local p="$1" r root ok=1 IFS
  case "$p" in *..*) deny "path with '..': $p" ;; esac
  # shellcheck disable=SC2088  # matches a literal "~/" typed by the agent
  case "$p" in "~/"*) p="$HOME/${p#\~/}" ;; "~") p="$HOME" ;; esac
  r="$p"
  if [ "${REMOTE-0}" = 0 ]; then
    r="$(realpath "$p" 2>/dev/null)" || deny "path not found: $1"
    IFS=,
    for root in ${RO_ROOTS:-$HOME/code}; do
      root="$(realpath "$root" 2>/dev/null)" || continue
      case "$r/" in "$root/"*) ok=0 ;; esac
    done
    [ "$ok" = 0 ] || deny "path outside RO_ROOTS (${RO_ROOTS:-$HOME/code}): $1"
  fi
  case "$r" in
    */.git/config|*/.ssh|*/.ssh/*|*/.aws|*/.aws/*|*/.kube|*/.kube/*|*.tfstate|*.tfstate.*|*/.env|*/.env.*|*.pem|*.key|*kubeconfig*|*/.netrc|*/.npmrc)
      deny "sensitive path: $1" ;;
  esac
  # The credential files of the core and the packs (the floor, hooks/credential-guard/credential-files)
  if cred_match "$r" || cred_match "$p"; then deny "credential file ($CRED_HIT): $1"; fi
}

check_git() {
  # shellcheck disable=SC2015  # deny exits, so this is if-then
  [ "${1-}" = -C ] && [ -n "${2-}" ] || deny "git: use 'git -C <dir> <subcommand> …'"
  check_path "$2"
  local sub="${3-}" a
  shift 3 || true
  case "$sub" in
    log|show|ls-files|ls-tree|grep|rev-parse|status|diff|blame|describe|for-each-ref|shortlog|cat-file|rev-list|merge-base|show-ref) ;;
    branch)
      for a in "$@"; do
        case "$a" in -a|-r|-v|-vv|-l|--all|--remotes|--list|--show-current|--format=*|--sort=*|--contains=*|--merged=*) ;;
          *) deny "git branch: only listing options (-a -r -v --list --show-current --format= --sort= --contains=)" ;;
        esac
      done ;;
    remote) [ "${1-}" = -v ] || [ "${1-}" = get-url ] || deny "git remote: only -v or get-url" ;;
    stash) [ "${1-}" = list ] || deny "git stash: only list" ;;
    *) deny "git: '$sub' not allowed (read-only subcommands only)" ;;
  esac
  for a in "$@"; do
    case "$a" in --output*|--ext-diff|--no-index|-O*|--open-files-in-pager*|--contents*) deny "git: $a not allowed" ;; esac
    # diff: paths stay inside the repository of -C. With a path outside it, 'git diff' compares plain files
    # (as --no-index) and shows any file of the machine. Relative paths and revisions (a..b, HEAD~2) pass.
    if [ "$sub" = diff ]; then
      # shellcheck disable=SC2088  # a literal "~" typed by the agent
      case "$a" in
        -*) ;;
        /*|"~"|"~/"*|..|../*|*/..|*/../*) deny "git diff: path outside the repository of -C: $a (use paths relative to it)" ;;
      esac
    fi
  done
}

check_gh() { # gh <group> <subcommand> …: GitHub reads only; never secrets, tokens or writes
  local group="${1-}" sub="${2-}" a method="" fields=0 endpoint=""
  case "$group" in
    repo|release|workflow) case "$sub" in list|view) ;; *) deny "gh: $group $sub not allowed (list, view)" ;; esac ;;
    pr) case "$sub" in list|view|diff|checks|status) ;; *) deny "gh: pr $sub not allowed (list, view, diff, checks, status)" ;; esac ;;
    issue) case "$sub" in list|view|status) ;; *) deny "gh: issue $sub not allowed (list, view, status)" ;; esac ;;
    run) case "$sub" in list|view) ;; *) deny "gh: run $sub not allowed (list, view)" ;; esac ;;
    label) [ "$sub" = list ] || deny "gh: label $sub not allowed (list)" ;;
    search) case "$sub" in repos|prs|issues|code|commits) ;; *) deny "gh: search $sub not allowed" ;; esac ;;
    auth) [ "$sub" = status ] || deny "gh: only 'auth status'" ;;
    api) ;;
    *) deny "gh: '$group' not allowed (repo, pr, issue, run, workflow, release, label, search, auth status, api GET)" ;;
  esac
  shift
  for a in "$@"; do
    case "$a" in
      -w|--web|--show-token|-t|--input|--input=*) deny "gh: $a not allowed" ;;
    esac
  done
  [ "$group" = api ] || return 0
  while [ $# -gt 0 ]; do
    case "$1" in
      -X|--method) method="${2-}"; shift ;;
      -X*) method="${1#-X}" ;;
      --method=*) method="${1#*=}" ;;
      -f|-F|--field|--raw-field) fields=1; shift ;;
      -f*|-F*|--field=*|--raw-field=*) fields=1 ;;
      -H|--header) case "$(lower "${2-}")" in *method*|*override*) deny "gh api: header $2 not allowed" ;; esac; shift ;;
      -q|--jq|--template|--hostname|--cache|-p|--preview) shift ;;
      -*) ;;
      *) [ -n "$endpoint" ] || endpoint="$1" ;;
    esac
    shift
  done
  [ -n "$endpoint" ] || deny "gh: use 'gh api <endpoint> …'"
  case "$(lower "$endpoint")" in graphql|/graphql|*secrets*|*/variables*|*token*|*/keys*) deny "gh api: $endpoint not allowed" ;; esac
  if [ -n "$method" ] && [ "$(lower "$method")" != get ]; then deny "gh api: only GET"; fi
  # -f/-F turn the request into a POST unless the method is set to GET
  if [ "$fields" = 1 ] && [ -z "$method" ]; then deny "gh api: -f/-F need '-X GET' (they imply POST)"; fi
}

check_files() { # $1 tool, rest args
  local tool="$1" a value="" pattern_done=0 opts=1 paths=0
  shift
  case "$tool" in grep) for a in "$@"; do case "$a" in -e|-e*|--regexp*|-f|--file*) pattern_done=1 ;; esac; done ;; esac
  for a in "$@"; do
    if [ -n "$value" ]; then
      [ "$value" = path ] && check_path "$a"
      value=""; continue
    fi
    if [ "$opts" = 1 ] && [ "$a" = -- ]; then opts=0; continue; fi
    if [ "$opts" = 1 ] && [ "${a#-}" != "$a" ]; then
      case "$tool $a" in
        "find -delete"|"find -exec"*|"find -ok"*|"find -fprint"*|"find -fls"|"tail -f"|"tail -F"|"tail --follow"*|"tail -r"*)
          deny "$tool: $a not allowed" ;;
        # They read a list of names from a file and print each one in their errors: any file would be shown
        *" --files0-from"*|"find -files0-from") deny "$tool: $a not allowed" ;;
        # A file given as the value of an option is a path like any other
        "grep --file="*|"grep --exclude-from="*|"grep --include-from="*) check_path "${a#*=}" ;;
        "head -n"|"head -c"|"tail -n"|"tail -c"|"grep -e"|"grep -A"|"grep -B"|"grep -C"|"grep -m"|"stat -f"|"stat -c") value=1 ;;
        "grep -f") value=path ;;
      esac
      [ "$tool" = find ] && [ "$paths" = 1 ] && break   # find: predicates start after the paths
      continue
    fi
    if [ "$tool" = grep ] && [ "$pattern_done" = 0 ]; then pattern_done=1; continue; fi
    if [ "$tool" = find ]; then case "$a" in '('|'!'|')') break ;; esac; fi
    check_path "$a"; paths=1
  done
  if [ "$tool" = find ]; then
    for a in "$@"; do case "$a" in -delete|-exec|-execdir|-ok|-okdir|-fprint|-fprint0|-fprintf|-fls) deny "find: $a not allowed" ;; esac; done
  fi
}

# Packs: each packs/<name>/ro.sh registers its tools with 'ro_tool <tool>' and defines check_<tool>
# (it may use deny, opt_val, in_list and lower). Every pack under packs/ is loaded, but only the tools of the
# packs chosen in the security profile run (packs= in ~/.config/infra-agent-harness/profile; packs/README.md).
# shellcheck source=bin/lib/packs.sh
. "$HARNESS/bin/lib/packs.sh"
# shellcheck source=bin/lib/profile.sh
. "$HARNESS/bin/lib/profile.sh"
TOOL_PACK=""   # " tool:pack tool:pack "
ro_tool() {
  [[ "$1" =~ ^[a-z0-9]+$ ]] || { echo "ro: bad tool name '$1' in a pack" >&2; exit 2; }
  case " $CORE_TOOLS $PACK_TOOLS " in *" $1 "*) echo "ro: tool '$1' registered twice" >&2; exit 2 ;; esac
  PACK_TOOLS="${PACK_TOOLS:+$PACK_TOOLS }$1"
  TOOL_PACK="$TOOL_PACK $1:$CUR_PACK"
}
set +f   # the only globs of this script (set -f above for the agent's arguments)
for pack in "$HARNESS"/packs/*/ro.sh; do
  [ -f "$pack" ] || continue
  CUR_PACK="$(basename "$(dirname "$pack")")"
  # shellcheck source=/dev/null
  . "$pack"
done
CHOSEN=" $(profile_packs "$HARNESS" | tr '\n' ' ') "
# shellcheck source=hooks/lib/credentials.sh
. "$HARNESS/hooks/lib/credentials.sh"   # already sourced by packs.sh only inside packs_permissions
cred_load "$HARNESS"
set -f
pack_of() { local tp; for tp in $TOOL_PACK; do [ "${tp%%:*}" = "$1" ] && { printf '%s' "${tp#*:}"; return; }; done; }
CHOSEN_TOOLS=""
for t in $PACK_TOOLS; do
  case "$CHOSEN" in *" $(pack_of "$t") "*) CHOSEN_TOOLS="${CHOSEN_TOOLS:+$CHOSEN_TOOLS }$t" ;; esac
done
for t in $PACK_TOOLS; do
  declare -F "check_$t" >/dev/null || { echo "ro: a pack registers '$t' but defines no check_$t" >&2; exit 2; }
done

validate() { # $@ = tool args…
  local tool="${1-}"
  [ -n "$tool" ] || usage
  shift
  case " $CHOSEN_TOOLS " in *" $tool "*) "check_$tool" "$@"; return ;; esac
  case " $PACK_TOOLS " in
    *" $tool "*) deny "tool '$tool' is in pack '$(pack_of "$tool")', not chosen in the security profile (security-profile show)" ;;
  esac
  case "$tool" in
    git) check_git "$@" ;;
    gh) check_gh "$@" ;;
    cat|head|tail|ls|find|grep|wc|stat) check_files "$tool" "$@" ;;
    *) deny "tool '$tool' not allowed ($(printf '%s' "$CHOSEN_TOOLS $CORE_TOOLS" | sed 's/^ //; s/ /, /g'))" ;;
  esac
}

run() { # $@ = tool args… (already validated)
  local tool="$1"
  shift
  local a args=()
  for a in "$@"; do # '~/…' arrives quoted (no shell expands it): expand it as check_path did
    # shellcheck disable=SC2088  # matches a literal "~/" typed by the agent
    case "$a" in "~/"*) args+=("$HOME/${a#\~/}") ;; *) args+=("$a") ;; esac
  done
  set -- ${args[@]+"${args[@]}"}
  export AWS_PAGER="" NO_COLOR=1
  [ "$(uname)" = Darwin ] && export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
  case "$tool" in
    git) exec git --no-pager --no-optional-locks "$@" ;;
    gh) GH_PAGER=cat GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 exec gh "$@" ;;
    grep) exec grep --exclude='*.tfstate*' --exclude='.env*' --exclude='*.pem' --exclude='*.key' --exclude-dir=.terraform "$@" ;;
    *) exec "$tool" "$@" ;;
  esac
}

mode() {
  case "${1-}" in
    on) mkdir -p "$(dirname "$MODE")"; printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${2-}" > "$MODE"; echo "ro: read-only mode ON ($MODE)" ;;
    off) rm -f "$MODE"; echo "ro: read-only mode OFF" ;;
    status) if [ -f "$MODE" ]; then echo "ro: ON since $(cat "$MODE")"; else echo "ro: OFF"; fi ;;
    *) usage ;;
  esac
}

host="" check=0
while [ $# -gt 0 ]; do
  case "$1" in
    --host) host="${2-}"; [ -n "$host" ] || usage
      # An SSH alias or user@host, never an option of ssh (-oProxyCommand=…)
      [[ "$host" =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]] || deny "--host: '$host' is not a host name or an SSH alias"
      shift 2 ;;
    --check) check=1; shift ;;
    mode) shift; mode "$@"; exit 0 ;;
    -h|--help) usage ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || usage

if [ -n "$host" ]; then
  REMOTE=1 validate "$@"
  flags=""; [ "$check" = 1 ] && flags="--check "
  exec ssh -o BatchMode=yes "$host" \
    "RO_PROFILES=$(printf %q "${RO_PROFILES-}") RO_CONTEXTS=$(printf %q "${RO_CONTEXTS-}") ${RO_REMOTE_BIN:-\$HOME/infra-agent-harness/bin/ro} $flags$(printf '%q ' "$@")"
fi

validate "$@"
if [ "$check" = 1 ]; then echo ok; exit 0; fi
run "$@"
