#!/usr/bin/env bash
# Print a template from templates/ in the record language of a repository.
# Usage: bin/render-template [--repo <dir>] <name> [KEY=VALUE ...]
#   name       record | decision | README | roadmap (file templates/<name>.md)
#   --repo     repository whose .harness.conf sets the language (default: the current git repo)
#   KEY=VALUE  fills {{KEY}}; placeholders without a value are left as they are
# {{VOC_*}} placeholders come from locale/<lang>.sh (see bin/lib/vocab.sh).
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source-path=SCRIPTDIR source=lib/vocab.sh
. "$HERE/lib/vocab.sh"

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; }

repo=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { usage >&2; exit 2; }
name="$1"; shift
case "$name" in *[!A-Za-z0-9_-]*) echo "render-template: invalid name '$name'" >&2; exit 2 ;; esac
tpl="$IAH_HOME/templates/$name.md"
[ -f "$tpl" ] || { echo "render-template: no template '$name' in templates/" >&2; exit 2; }
[ -n "$repo" ] || repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

vocab_load "$repo"

pairs="$(mktemp)"
trap 'rm -f "$pairs"' EXIT
for v in "${!VOC_@}"; do
  [ "$v" = VOC_LANG ] && continue
  printf '%s\t%s\n' "$v" "${!v}" >> "$pairs"
done
for kv in "$@"; do
  case "$kv" in
    *=*) printf '%s\t%s\n' "${kv%%=*}" "${kv#*=}" >> "$pairs" ;;
    *) echo "render-template: argument '$kv' is not KEY=VALUE" >&2; exit 2 ;;
  esac
done

# Literal replacement (no regex), so values may hold any character but a tab or a newline.
awk -F'\t' '
  function repl(s, k, v,   out, p) {
    out = ""
    while ((p = index(s, k)) > 0) { out = out substr(s, 1, p - 1) v; s = substr(s, p + length(k)) }
    return out s
  }
  NR == FNR { n++; key[n] = "{{" $1 "}}"; val[n] = substr($0, length($1) + 2); next }
  { line = $0; for (i = 1; i <= n; i++) line = repl(line, key[i], val[i]); print line }
' "$pairs" "$tpl"
