# Credential files of the core: agents never read, copy or send them (packs/README.md, "Credential files").
# One pattern per line: '~/<path>' (from the home directory) or '**/<name>' (that file name anywhere). '*' is any
# text. Each line is also a Claude Code deny rule: Read(~/<path>) or Read(//**/<name>). The packs add theirs in
# packs/<name>/credential-files.

# SSH private keys (the .pub files stay readable)
~/.ssh/id_rsa
~/.ssh/id_dsa
~/.ssh/id_ecdsa
~/.ssh/id_ed25519
~/.ssh/id_ecdsa_sk
~/.ssh/id_ed25519_sk

# Tokens and passwords of common tools
~/.netrc
~/.git-credentials
~/.docker/config.json
~/.npmrc
~/.pypirc
~/.config/gh/hosts.yml

# This harness: the evidence key and the cached Bitwarden session (modules/evidence)
~/.config/infra-agent-harness/evidence.key
~/.config/infra-agent-harness/bw-session

# Anywhere. Not *.pem (mostly public certificates) nor .env.* (would hide .env.example)
**/.env
**/.env.local
**/.env.production
**/*.key
