# Commands of the core that print a secret without opening a file (credential-guard, packs/README.md "Commands
# that show secrets"). Blocked when their output is shown: on the screen, in a file or through a reader
# (gh auth token, … > t.txt, … | base64). Using it passes: piped into a tool that is not a reader
# (… | docker login --password-stdin) or kept in a variable (TOKEN=$(…), export TOKEN=$(…)).
# One per line: '<command> <word> …'. The command and every word must be there, the words in any order after
# the command; '*' is any text. Packs add theirs in packs/<name>/secret-commands.

# GitHub CLI
gh auth token
gh auth status --show-token
gh auth status -t

# Bitwarden CLI (the evidence module keeps its session with BW_SESSION=$(bw unlock --raw), a use)
bw get password
bw get item
bw get notes
bw get totp
bw list items
bw export
bw unlock --raw
bw login --raw

# git and docker credential helpers
git credential fill
git credential-store get
git credential-cache get
docker-credential-* get

# macOS keychain (-w prints the password)
security find-generic-password -w
security find-internet-password -w
