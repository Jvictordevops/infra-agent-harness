#!/usr/bin/env bash
# Install a pinned gitleaks release after checking its sha256. Used by the CI.
# Dependabot does not see this file: bump VERSION and SHA256 together by hand
# (SHA256 = digest of gitleaks_<VERSION>_linux_x64.tar.gz on the release page).
# Usage: .github/scripts/install-gitleaks [dest-dir]   (default: $RUNNER_TEMP/bin, added to $GITHUB_PATH)
set -euo pipefail
VERSION=8.30.1
SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

dest="${1:-${RUNNER_TEMP:?set RUNNER_TEMP or pass a directory}/bin}"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
mkdir -p "$dest"
curl -fsSL --retry 3 -o "$tmp/gitleaks.tar.gz" \
  "https://github.com/gitleaks/gitleaks/releases/download/v${VERSION}/gitleaks_${VERSION}_linux_x64.tar.gz"
echo "${SHA256}  $tmp/gitleaks.tar.gz" | sha256sum -c --quiet -
tar -xzf "$tmp/gitleaks.tar.gz" -C "$dest" gitleaks
[ -n "${GITHUB_PATH:-}" ] && echo "$dest" >> "$GITHUB_PATH"
"$dest/gitleaks" version
