#!/usr/bin/env bash
# Install a pinned gitleaks release after checking its sha256. Used by the CI.
# Dependabot does not see this file: bump VERSION and the three digests together by hand
# (from gitleaks_<VERSION>_checksums.txt on the release page).
# Usage: .github/scripts/install-gitleaks [dest-dir]   (default: $RUNNER_TEMP/bin, added to $GITHUB_PATH)
set -euo pipefail
VERSION=8.30.1
case "$(uname -s)_$(uname -m)" in
  Linux_x86_64)  PLATFORM=linux_x64    SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;;
  Darwin_arm64)  PLATFORM=darwin_arm64 SHA256=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5 ;;
  Darwin_x86_64) PLATFORM=darwin_x64   SHA256=dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709 ;;
  *) echo "install-gitleaks: no pinned build for $(uname -s) $(uname -m)" >&2; exit 2 ;;
esac

dest="${1:-${RUNNER_TEMP:?set RUNNER_TEMP or pass a directory}/bin}"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
mkdir -p "$dest"
curl -fsSL --retry 3 -o "$tmp/gitleaks.tar.gz" \
  "https://github.com/gitleaks/gitleaks/releases/download/v${VERSION}/gitleaks_${VERSION}_${PLATFORM}.tar.gz"
sum="$( (sha256sum "$tmp/gitleaks.tar.gz" 2>/dev/null || shasum -a 256 "$tmp/gitleaks.tar.gz") | cut -d' ' -f1)"
[ "$sum" = "$SHA256" ] || { echo "install-gitleaks: checksum mismatch for $PLATFORM" >&2; exit 1; }
tar -xzf "$tmp/gitleaks.tar.gz" -C "$dest" gitleaks
[ -n "${GITHUB_PATH:-}" ] && echo "$dest" >> "$GITHUB_PATH"
"$dest/gitleaks" version
