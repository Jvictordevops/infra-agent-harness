# Commands of the kubernetes pack that print a secret (format: hooks/credential-guard/secret-commands).
# Listing or describing Secrets passes (kubectl get secrets, kubectl describe secret x show no values); any
# -o/--output of a Secret is blocked, also -o name.

# Credentials of the agent: the kubeconfig with its keys and tokens, a new service account token
kubectl config view --raw
kubectl config view --raw=true
kubectl config view --flatten
kubectl config view --flatten=true
kubectl create token

# Values of Secrets
kubectl get secret* -o*
kubectl get secret* --output*
kubectl get *,secret* -o*
kubectl get *,secret* --output*
kubectl get --raw */secrets*
kubectl get --raw=*/secrets*
