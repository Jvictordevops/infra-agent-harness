# Commands of the aws pack that print a secret (format: hooks/credential-guard/secret-commands): the
# credentials of the agent and the values of the secrets of applications. Listing or describing them passes.

# Credentials and tokens of the agent
aws configure export-credentials
aws configure get *secret*
aws configure get *token*
aws sts get-session-token
aws sts get-federation-token
aws sts assume-role*
aws sso get-role-credentials
aws ecr get-login-password
aws ecr get-authorization-token
aws ecr-public get-login-password
aws ecr-public get-authorization-token
aws codeartifact get-authorization-token
aws eks get-token
aws rds generate-db-auth-token
aws iam create-access-key
aws iam create-service-specific-credential

# Values of the secrets of applications
aws secretsmanager get-secret-value
aws secretsmanager batch-get-secret-value
# the CLI takes any unique prefix of an option: --with-decrypt, --with-d, --w
aws ssm get-parameter* --w*
aws kms decrypt
